{
  "name": "murmur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ensure-config": "node scripts/ensure-config.mjs",
    "dev": "pnpm ensure-config && concurrently -n worker,widget -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:widget\"",
    "dev:server": "pnpm --filter @murmur/server dev",
    "dev:widget": "pnpm --filter @murmur/widget dev",
    "build": "pnpm ensure-config && pnpm --filter @murmur/widget build",
    "build:cli": "pnpm --filter @knowtific/murmur build",
    "murmur": "node packages/cli/dist/cli.js",
    "sync:plugin": "pnpm build:cli && node packages/cli/dist/cli.js skill print > plugin/skills/website-chatbot/SKILL.md && node packages/cli/dist/cli.js help agents > packages/cli/AGENTS.md && node packages/cli/dist/cli.js help wiki-cli > wiki/CLI-Reference.md && node packages/cli/dist/cli.js help wiki-config > wiki/Configuration-Reference.md",
    "test": "pnpm ensure-config && vitest run",
    "test:watch": "pnpm ensure-config && vitest",
    "e2e": "pnpm ensure-config && playwright test",
    "e2e:ui": "pnpm ensure-config && playwright test --ui",
    "typecheck": "pnpm ensure-config && pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "lint": "eslint .",
    "eval": "node packages/cli/dist/cli.js eval",
    "pack:cli": "pnpm build:cli && pnpm --filter @knowtific/murmur pack --pack-destination \"$PWD\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "dependencies": {
    "@murmur/server": "workspace:*"
  }
}
